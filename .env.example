# ===================================
# LINE → Discord ステータスボード 設定
# ===================================
# このファイルを .env にコピーして値を設定してください
# cp .env.example .env

# --- LINE Bot 設定 ---
# LINE Developers Console で取得
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# --- Discord Bot 設定 ---
# Discord Developer Portal で取得
DISCORD_BOT_TOKEN=your_discord_bot_token

# ステータスを表示するチャンネルのID
# チャンネルを右クリック → 「IDをコピー」で取得
DISCORD_CHANNEL_ID=your_discord_channel_id

# --- オプション設定 ---
# ステータスが自動でOFFになるまでの時間（時間）
STATUS_TIMEOUT_HOURS=3

# 通知ウィンドウ（分）- この時間内に2個目のスタンプで @here 通知
NOTIFY_WINDOW_MINUTES=60

# サーバーポート
PORT=3000
